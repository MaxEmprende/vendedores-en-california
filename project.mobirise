  },
  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Inicio",
        "meta_descr": "Soy el coach de Ventas Max, y te ayudaré en tu proceso de crecimiento como vendedor. Cuento con cursos gratuitos para aquellas personas que quieran vender más y mejor.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
